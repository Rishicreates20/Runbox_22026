# Copy to .env (docker compose reads it automatically) or export these before
# running the services directly. Never commit the real .env.

# Postgres and Redis. Compose builds DATABASE_URL from POSTGRES_PASSWORD, so
# keep the password URL-safe (letters and digits): openssl rand -hex 24
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://codeplus:change-me@127.0.0.1:5432/codeplus
REDIS_URL=redis://127.0.0.1:6379

# Bearer token for POST /api/problems and the /admin upload page.
# Generate one with: openssl rand -base64 24
ADMIN_TOKEN=change-me

# Web
WEB_PORT=3000
# Set to 1 only in development to let paper links point at private/LAN hosts.
# PAPER_FETCH_ALLOW_PRIVATE=0

# Judge (defaults shown)
# JUDGE_CONCURRENCY=2                         # parallel submissions
# RUNBOX_BIN=./runbox
# RUNBOX_ROOTFS=/var/lib/runbox/rootfs        # run image
# RUNBOX_COMPILE_ROOTFS=/var/lib/runbox/rootfs-gcc  # compile image (gcc)
# RUNBOX_CGROUP=auto                          # auto | v2 | v1
# JUDGE_WORKDIR=/var/lib/codeplus/jobs
